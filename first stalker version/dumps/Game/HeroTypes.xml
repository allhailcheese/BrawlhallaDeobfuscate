	<HeroType HeroName="Viking">
		<HeroID>3</HeroID>
		<HeroDisplayName>BÖDVAR</HeroDisplayName>
		<BotDisplayName>BÖTVAR</BotDisplayName>
		<MissionTags>HammerUser,SwordUser,Male</MissionTags>
		<NameSound>Name_Bodvar</NameSound>
		<OnSelectedSound>[420]Bodvar_CS</OnSelectedSound>
		<CostumeName>Viking</CostumeName>
		<TrailEffect>SmokeTrailEffect</TrailEffect>
